# Copy this file to .env and fill in real values for local development.
NODE_ENV=development
PORT=4000

# Local MongoDB (docker-compose up -d mongo)
MONGODB_URI=mongodb://localhost:27017/barbellix

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Comma-separated - mobile (Expo web) and web (Vite) dev servers
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Error monitoring (Sentry) - leave blank to disable entirely, including locally
SENTRY_DSN=

# AI Coach provider keys (moved here from apps/mobile/.env - server-only, never EXPO_PUBLIC_ prefixed)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Object storage for uploaded media (avatars, exercise videos) - defaults to local disk
# (apps/server/uploads/), no configuration needed for local dev.
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS_JSON=
# PUBLIC_URL=

# "Sign in with Google" - from a Google Cloud Console project (APIs & Services > Credentials >
# OAuth 2.0 Client ID, type "Web application"). Leave blank to disable POST /auth/google entirely.
# The web app (VITE_GOOGLE_CLIENT_ID) and mobile app (EXPO_PUBLIC_GOOGLE_CLIENT_ID) must be set to
# this exact same value - Google ties each ID token's audience to the client ID that requested it.
GOOGLE_CLIENT_ID=

# SMS delivery for cash-payment OTP confirmation (front desk collects cash, member confirms by
# SMS code). Leave blank to disable the cash-OTP flow with a clear error instead of a crash.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cashfree payment gateway (UPI + cards) - from the Cashfree merchant dashboard (Developers >
# API Keys). Leave blank to keep membership-plan CRUD/manual mark-paid working without real
# online checkout. CASHFREE_ENV=sandbox for testing, 'production' when ready to go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=http://localhost:5173/billing/return
