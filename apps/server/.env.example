# Copy this file to .env and fill in real values for local development.
NODE_ENV=development
PORT=4000

# Local MongoDB (docker-compose up -d mongo)
MONGODB_URI=mongodb://localhost:27017/barbellix

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Comma-separated - mobile (Expo web) and web (Vite) dev servers
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Error monitoring (Sentry) - leave blank to disable entirely, including locally
SENTRY_DSN=

# AI Coach provider keys (moved here from apps/mobile/.env - server-only, never EXPO_PUBLIC_ prefixed)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Object storage for uploaded media (avatars, exercise videos) - defaults to local disk
# (apps/server/uploads/), no configuration needed for local dev.
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS_JSON=
# PUBLIC_URL=
