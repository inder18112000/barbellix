# Copy this file to .env for local development.
VITE_API_BASE_URL=http://localhost:4000

# Error monitoring (Sentry) - leave blank to disable entirely, including locally
VITE_SENTRY_DSN=

# "Sign in with Google" - same OAuth 2.0 Web application Client ID as the server's
# GOOGLE_CLIENT_ID (apps/server/.env). Leave blank to hide the Google button entirely.
VITE_GOOGLE_CLIENT_ID=
