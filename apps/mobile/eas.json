{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "http://localhost:4000"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://barbellix-server.vercel.app"
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://barbellix-server.vercel.app"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
