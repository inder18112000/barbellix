# Copy this file to .env for local development.
# On a physical device via Expo Go, this must be your dev machine's LAN IP,
# not localhost (the device can't resolve "localhost" as your computer).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# "Sign in with Google" - from a Google Cloud Console project (APIs & Services > Credentials).
# WEB_CLIENT_ID is required (Expo Go signs in via the web OAuth client even on mobile); the
# platform-specific ones are only needed for standalone/EAS builds. Leave WEB_CLIENT_ID blank to
# hide the button entirely. All three, plus the server's GOOGLE_CLIENT_ID, come from the same
# Google Cloud project but are different Client ID *types* (Web application / iOS / Android).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
